# 複製成 .env 再填值：cp .env.example .env
# .env 有密碼，不要 commit（已在 .gitignore）

# ---------------- 本機直接跑（python main.py）時連的資料庫 ----------------
# 用 Docker Compose 跑時，這行會被 docker-compose.yml 蓋掉，改連容器裡的 db
SQLALCHEMY_DATABASE_URI=mysql+pymysql://root:你的密碼@127.0.0.1:3306/first?charset=utf8mb4

# ---------------- JWT ----------------
# 隨機長字串，可用：python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# ---------------- 郵件（Gmail 要用「應用程式密碼」，不是登入密碼）----------------
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=

# ---------------- 其他 ----------------
# 本機 python main.py 的埠號（macOS AirPlay 佔用 5000）
PORT=5001
# 1 = 每個等級各寫一個檔到 log/（debug、info、warning、error、critical）
LOG_TO_FILE=1

# ---------------- Docker Compose 專用 ----------------
# MySQL 容器的帳密：只在第一次建立資料庫時生效
# 密碼請避開 @ : / ? # 這些字元（會放進連線字串）
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=first
MYSQL_USER=first_app
MYSQL_PASSWORD=
# 本機連進容器用的埠號
APP_PORT=5001
DB_PORT=3307
